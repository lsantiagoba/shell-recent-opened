msgid "Recent applications"
msgstr "최근 사용한 애플리케이션"

msgid "No applications yet"
msgstr "아직 애플리케이션이 없습니다"

msgid "Recent documents"
msgstr "최근 문서"

msgid "No documents yet"
msgstr "아직 문서가 없습니다"

msgid "Clear history"
msgstr "기록 지우기"

msgid "Clear recent history?"
msgstr "최근 기록을 지우시겠습니까?"

msgid "This removes the list of recent applications and the recently opened files of all applications."
msgstr "최근 애플리케이션 목록과 모든 애플리케이션에서 최근에 연 파일이 삭제됩니다."

msgid "Cancel"
msgstr "취소"

msgid "Clear"
msgstr "지우기"

msgid "Settings"
msgstr "설정"

msgid "Top bar and Dash"
msgstr "상단 표시줄과 대시"

msgid "Top bar button"
msgstr "상단 표시줄 버튼"

msgid "Dash launcher"
msgstr "대시 실행기"

msgid "Opens the top bar menu, or the app grid when the button is hidden"
msgstr "상단 표시줄 메뉴를 열거나, 버튼이 숨겨져 있으면 앱 그리드를 엽니다"

msgid "App grid"
msgstr "앱 그리드"

msgid "Items per section"
msgstr "섹션별 항목 수"
