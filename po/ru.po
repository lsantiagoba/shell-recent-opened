msgid "Recent applications"
msgstr "Недавние приложения"

msgid "No applications yet"
msgstr "Приложений пока нет"

msgid "Recent documents"
msgstr "Недавние документы"

msgid "No documents yet"
msgstr "Документов пока нет"

msgid "Clear history"
msgstr "Очистить историю"

msgid "Clear recent history?"
msgstr "Очистить недавнюю историю?"

msgid "This removes the list of recent applications and the recently opened files of all applications."
msgstr "Будут удалены список недавних приложений и недавно открытые файлы всех приложений."

msgid "Cancel"
msgstr "Отмена"

msgid "Clear"
msgstr "Очистить"

msgid "Settings"
msgstr "Настройки"

msgid "Top bar and Dash"
msgstr "Верхняя панель и Dash"

msgid "Top bar button"
msgstr "Кнопка на верхней панели"

msgid "Dash launcher"
msgstr "Значок в Dash"

msgid "Opens the top bar menu, or the app grid when the button is hidden"
msgstr "Открывает меню верхней панели или сетку приложений, если кнопка скрыта"

msgid "App grid"
msgstr "Сетка приложений"

msgid "Items per section"
msgstr "Элементов в разделе"
