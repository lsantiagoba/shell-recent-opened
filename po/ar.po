msgid "Recent applications"
msgstr "التطبيقات الأخيرة"

msgid "No applications yet"
msgstr "لا توجد تطبيقات بعد"

msgid "Recent documents"
msgstr "المستندات الأخيرة"

msgid "No documents yet"
msgstr "لا توجد مستندات بعد"

msgid "Clear history"
msgstr "مسح السجل"

msgid "Clear recent history?"
msgstr "مسح السجل الأخير؟"

msgid "This removes the list of recent applications and the recently opened files of all applications."
msgstr "يزيل هذا قائمة التطبيقات الأخيرة والملفات التي فُتحت مؤخرًا في جميع التطبيقات."

msgid "Cancel"
msgstr "إلغاء"

msgid "Clear"
msgstr "مسح"

msgid "Settings"
msgstr "الإعدادات"

msgid "Top bar and Dash"
msgstr "الشريط العلوي والمرسى"

msgid "Top bar button"
msgstr "زر الشريط العلوي"

msgid "Dash launcher"
msgstr "مشغّل المرسى"

msgid "Opens the top bar menu, or the app grid when the button is hidden"
msgstr "يفتح قائمة الشريط العلوي، أو شبكة التطبيقات عند إخفاء الزر"

msgid "App grid"
msgstr "شبكة التطبيقات"

msgid "Items per section"
msgstr "عدد العناصر في كل قسم"
